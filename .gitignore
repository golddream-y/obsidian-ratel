# vscode
.vscode

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include compiled bundle output in the repo.
# They should be uploaded to GitHub releases instead.
dist/

# Test tmp directories (created by vector-vectra + integration tests)
tests/tmp/

# Exclude sourcemaps
*.map

# obsidian
data.json

# macOS
.DS_Store

# ratel-vault data (stored in .obsidian/plugins/ratel-vault/)
*.db
*.lance

# Git worktrees (per using-git-worktrees skill)
.worktrees/

# 临时 scratch / 会话结论(不进版本库)
.temp/

# 本地 Cursor 配置（已移出版本库，防止误加）
.cursor/

# 含本机绝对路径的本地指令层（宿主叠加加载），不进 GitHub
AGENTS.local.md
CLAUDE.local.md

# Superpowers brainstorming 可视化会话（仅本机）
.superpowers/

# 生成的分析报告（体积大、可再生成，不入库）
*-report.json
c2-chunk-migration-report.json
